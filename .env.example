# Copy this file to ".env" and paste your own keys after the = sign.
# All keys are optional. With none, the skill still measures Claude (built-in web search)
# and runs the free website audit. Never commit your real .env file.

# FREE: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# PAID (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=

# Optional model overrides (only if a model is retired)
# OPENAI_MODEL=gpt-5-mini
# CLAUDE_MODEL=claude-opus-5
# PERPLEXITY_MODEL=sonar
# GEMINI_MODEL=gemini-flash-latest
